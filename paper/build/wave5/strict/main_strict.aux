\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces What 128 added columns change, relative to the 25 features alone, under each frozen readout (mean over six encoder seeds; absolute scores are in Table~\ref {tab:scorecard}). $+\mu $: our encoder. No prediction term: the same recipe trained without the GRU prediction term. Untrained: a randomly initialised encoder, which is a single encoder and carries no band. Bold: beyond $2\,\mathrm  {SE}$. The last row counts tasks won, tied and lost at that bar.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:readout}{{2}{7}{What 128 added columns change, relative to the 25 features alone, under each frozen readout (mean over six encoder seeds; absolute scores are in Table~\ref {tab:scorecard}). $+\mu $: our encoder. No prediction term: the same recipe trained without the GRU prediction term. Untrained: a randomly initialised encoder, which is a single encoder and carries no band. Bold: beyond $2\,\mathrm {SE}$. The last row counts tasks won, tied and lost at that bar}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C}Validation reconstruction against downstream score}{8}{appendix.C}\protected@file@percent }
\newlabel{app:valloss}{{C}{8}{Validation reconstruction against downstream score}{appendix.C}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One point per pre-training recipe (mean over its seeds), one panel per task. (a) The exp05 sweep: ten recipes sharing corpus, architecture and loss terms, differing only in the GRU prediction term (off, forward, forward+backward, multi-step, the last three at three weights), four seeds each. (b) The family our encoder belongs to: 19 recipes on the final encoder that vary the form, weight and floor of the spectral auxiliary term, six seeds each; the diamond has no auxiliary term, the cross is the one dynamics-off recipe, the star is the recipe we use. $x$: best post-warm-up validation reconstruction loss; $y$: PR-AUC of the fixed linear probe on $\mu $; $\rho $: Spearman's between negated loss and score.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:valloss}{{2}{8}{One point per pre-training recipe (mean over its seeds), one panel per task. (a) The exp05 sweep: ten recipes sharing corpus, architecture and loss terms, differing only in the GRU prediction term (off, forward, forward+backward, multi-step, the last three at three weights), four seeds each. (b) The family our encoder belongs to: 19 recipes on the final encoder that vary the form, weight and floor of the spectral auxiliary term, six seeds each; the diamond has no auxiliary term, the cross is the one dynamics-off recipe, the star is the recipe we use. $x$: best post-warm-up validation reconstruction loss; $y$: PR-AUC of the fixed linear probe on $\mu $; $\rho $: Spearman's between negated loss and score}{figure.2}{}}
